# HunyForge API
HUNYFORGE_DEMO=1
HUNYFORGE_DATA_ROOT=./data

# Official Hunyuan3D 2.1 service
# HUNYUAN_ROOT must point to the official GitHub checkout containing api_server.py.
# The downloaded Hugging Face weights snapshot is separate from that checkout.
HUNYUAN_ROOT=
HUNYUAN_PYTHON=C:\Users\Skeet\miniconda3_mini\envs\ai-toolkit\python.exe
HUNYUAN_API_URL=http://127.0.0.1:8082
HUNYUAN_REQUEST_TIMEOUT_SECONDS=3600
HUNYUAN_RENDER_SIZE=1024
HUNYUAN_TEXTURE_SIZE=2048
HUNYUAN_MODEL_PATH=D:\AI_Models\Hunyuan3D-2.1
# Set to 1 only for older local servers that require raw base64 instead of a data URL.
HUNYUAN_STRIP_DATA_URL=0

# Native local Hunyuan3D-2mv worker. The worker is started with:
# docker compose --profile multiview up -d --build
HUNYFORGE_MULTI_VIEW_URL=http://hunyforge-multiview:8083
HUNYUAN2MV_MODEL_HOST_PATH=D:\AI_Models\Hunyuan3D-2mv
HUNYUAN2MV_SUBFOLDER=hunyuan3d-dit-v2-mv-turbo
HUNYUAN2MV_FLASHVDM=1

# Optional local wrapper for Hunyuan3D-Omni inference.py.
# Supported placeholders: {image} {control_type} {control_data} {output} {seed}
HUNYUAN_OMNI_COMMAND=

# Worker memory isolation (see OOM-ISSUES.md). Each pipeline stage runs in a
# fresh subprocess so the OS reclaims model RSS on exit; set to 0 only to run
# stages in-process for debugging. The admission gate rejects a stage with
# insufficient_memory when the VM has less headroom than this threshold.
HUNYFORGE_STAGE_ISOLATION=1
HUNYFORGE_MIN_AVAILABLE_MB=12288

HUNYUAN_DINO_DEVICE=cpu
HUNYUAN_FLASHVDM=0
HUNYUAN_COMPILE=0
HUNYUAN_CPU_THREADS=8
HUNYUAN_MODEL_REVISION=0b94677654c57bb9a6b6845cd7b704ccf551d327
HUNYUAN_SOURCE_REVISION=82920d643c0dc2f7bfd7255f45f62d386edfe60c
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
